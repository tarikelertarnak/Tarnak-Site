# Tarnak-Site örnek ortam değişkenleri — kopyalayıp `.env.local` olarak kaydet.
# Gerçek değerler repo'ya ASLA girmez (`.gitignore` -> `.env*`).

# Supabase (proje URL'si + anon key — public'tir)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin paneli koruması (güçlü rastgele değer kullan)
ADMIN_SECRET=

# Supabase service role — YALNIZ sunucu tarafında kullanılır (asla NEXT_PUBLIC_ değil)
SUPABASE_SERVICE_ROLE=

# Reklam (AdSense)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Arcjet (bot/kötüye kullanım koruması) — boşsa devre dışı
ARCJET_KEY=

# GitHub veri çekme (public/github-data.json üretimi, `prebuild`)
# Sadece okuma (Contents RO) scope'lu fine-grained token önerilir
GITHUB_TOKEN=

# Bağış bildirimleri (opsiyonel)
DISCORD_WEBHOOK_URL=

# Deploy ortamında Cloudflare bunu doldurur — canonical/origin olarak kullanma (hash'li URL)
CF_PAGES_URL=