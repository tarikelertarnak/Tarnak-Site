# ─────────────────────────────────────────────────────────────────────────────
# .env.example — ŞABLON. Buradaki hiçbir değer GERÇEK DEĞİLDİR.
#
# Kopyalayıp `.env.local` yap, değerleri kendin doldur:
#   cp .env.example .env.local
#
# `.env*` gitignore'da (`.env.example` hariç) — gizli dosya repoya GİRMEZ.
# Bu dosyayı gitle taraması (gitleaks) her commit öncesi kontrol eder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# ZORUNLU. Alan adın buraya. Tüm canonical/sitemap/OG adresleri buradan üretilir.
# Şimdilik pages.dev adresi; kendi alan adını alınca TEK YERDEN değiştir.
NEXT_PUBLIC_SITE_URL=https://tarikelertarnak.pages.dev

# ── Supabase ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* olanlar İSTEMCİYE gider (anon keyi güvenlidir, RLS korur).
# SUPABASE_SERVICE_ROLE_KEY istemciye ASLA gitmez — yalnızca sunucu tarafında.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Dashboard → Project Settings → API → service_role key
# ⚠️ Bu anahtarla tüm veritabanına erişilir. SIZDIRMA.
SUPABASE_SERVICE_ROLE_KEY=
# Eski kurulumlar için geçici geriye uyumluluk adı; yeni kurulumda kullanma.
SUPABASE_SERVICE_ROLE=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# (Shell'da `stitch login` DEĞİL, bu site için OAuth Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Yönetici olması gereken hesap (yalnızca bu e-posta giriş yapabilir).
GOOGLE_ADMIN_EMAIL=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Kullanıcı/hesap verisi çekmek için. İstemciye GÖNDERİLMEZ.
# GitHub → Settings → Developer settings → Personal access tokens → `read:user`
GITHUB_TOKEN=

# ── Cloudflare ───────────────────────────────────────────────────────────────
# Workers KV rate-limit + deploy. Cloudflare Dashboard → My Profile → API Tokens
# → "Edit Cloudflare Workers" şablonu.
CLOUDFLARE_API_TOKEN=

# ── Güvenlik / bot koruması (isteğe bağlı ama önerilir) ─────────────────────
# Cloudflare Turnstile (ücretsiz). Site Key istemciye, Secret Key sunucuya.
# Boş bırakılırsa Turnstile KAPALI kalır ve honeypot + rate limit devrede olur.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
#
# Arcjet (ücretsiz katman). @arcjet/next zaten kurulu; anahtar yoksa bot
# koruması devre dışı kalır.
ARCJET_KEY=
#
# Bot koruması için tek anahtar: 'arcjet' | 'turnstile' | 'none'
# Boşsa otomatik seçilir (önce Turnstile, sonra Arcjet).
FORM_BOT_PROTECTION=

# ── Bildirim (isteğe bağlı) ─────────────────────────────────────────────────
# İletişim formu mesajlarının gideceği Discord webhook.
DISCORD_WEBHOOK_URL=
# Formu gönderdiğinde kendine gelen e-posta (Resend/SMTP yerine basit bildirim).
CONTACT_NOTIFY_EMAIL=

# ── Ölçüm / analitik (isteğe bağlı) ─────────────────────────────────────────
# Hata izleme. Sentry edge uyumlu; kişisel veri GÖNDERİLMEZ (PII maskeleme).
# Boş bırakılırsa Sentry kurulmaz.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# ── Önceki sürümlerde kullanılan, hâlâ desteklenen anahtarlar ────────────────
# Silinmedi; kod hâlâ okuyor. Yeni kurulumda gerekmiyor.

# Admin paneli ek anahtar (route koruması). Boş bırakılırsa oturum kontrolü
# düşer. Uzun, rastgele bir dizi olmalı.
ADMIN_SECRET=

# Google AdSense. Boş bırakılırsa reklam ağı hiç bağlanmaz ve CSP dışarıda
# kalır (önerilen durum). Doldurulursa CSP'ye Google origin'leri eklenir.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Cloudflare Pages adresi (eski dağıtım yapısı; site URL'i artık
# NEXT_PUBLIC_SITE_URL üzerinden üretiliyor).
CF_PAGES_URL=
# ── Bakım modu (2026-10-07, Faz 1 · operasyon) ─────────────────────────────────
# `1` yapılırsa site 503 + "bakımdayız" sayfası verir (noindex).
# Kapatmak için değeri sil (ya da `0`) ve Cloudflare'de yeniden deploy et.
# Statik varlıklar (JS/CSS/görsel) sunulmaya devam eder.
MAINTENANCE_MODE=
# Bakım sayfasının dili: tr (varsayılan) | en
MAINTENANCE_LANG=tr
