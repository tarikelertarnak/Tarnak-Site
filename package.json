{
  "name": "tarikeler-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "author": {
    "name": "TARIKELER",
    "url": ""
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');const f='scripts/fetch-github-data.cjs';if(fs.existsSync(f)){require('./'+f)}else{console.log('[prebuild] scripts/fetch-github-data.cjs yok (eski branch) - atlandi, committed snapshot kullanilir')}\"",
    "dev": "next dev --turbopack",
    "dev:fast": "next dev --turbopack --no-preinstall",
    "build": "next build",
    "opennext:build": "opennextjs-cloudflare build",
    "pages:build": "opennextjs-cloudflare build && node scripts/pages-copy-worker.cjs",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "lint": "eslint . || true",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"const fs=require('fs');const f='scripts/patch-lightningcss.cjs';if(fs.existsSync(f)){require('./'+f)}else{console.log('[postinstall] scripts/patch-lightningcss.cjs yok (eski branch) - atlandi')}\"",
    "prepare": "husky",
    "perf": "node scripts/measure-lighthouse.mjs http://localhost:3000",
    "perf:ci": "npx lhci autorun"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@arcjet/next": "1.13.0",
    "@emotion/css": "latest",
    "@emotion/react": "latest",
    "@fontsource/montserrat": "^5.3.0",
    "@heroui/react": "^2.8.5",
    "@iconify/react": "^6.0.2",
    "@lobehub/ui": "^5.24.0",
    "@rc-component/qrcode": "^2.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "antd": "^6.5.3",
    "antd-style": "latest",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "emoji-picker-element": "^1.29.1",
    "libphonenumber-js": "^1.13.13",
    "marked": "^18.0.7",
    "motion": "^12.43.0",
    "next": "^16.4.0",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^6.2.4",
    "sanitize-html": "^2.17.6",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@next/eslint-plugin-next": "^15.5.7",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.64.0",
    "@sentry/cloudflare": "^11.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^2.1.9",
    "critters": "^0.0.25",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "wrangler": "^4.131.1"
  },
  "allowScripts": {
    "lightningcss-win32-x64-msvc@1.32.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@heroui/shared-utils@2.1.12": true
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7",
      "lodash": ">=4.18.0",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.18",
      "source-map-js": ">=1.2.2"
    }
  }
}
